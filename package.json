{
  "name": "@flarelight-io/reporting",
  "version": "0.10.1",
  "description": "Report Viewer and Widgets packaged as Web Components",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/flarelight-reporting/flarelight-reporting.esm.js",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "exports": {
    ".": {
      "import": "./dist/flarelight-reporting/flarelight-reporting.esm.js",
      "require": "./dist/flarelight-reporting/flarelight-reporting.cjs.js"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    },
    "./schema": "./src/schema.json"
  },
  "files": [
    "dist/",
    "loader/",
    "src/schema.json"
  ],
  "scripts": {
    "build": "npx stencil build",
    "start": "npx stencil build --dev --watch --serve",
    "test": "npx stencil test --spec --e2e",
    "test.watch": "npx stencil test --spec --e2e --watchAll",
    "generate": "npx stencil generate",
    "bundle:esbuild": "node create-esbuild-bundle.js"
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "gridstack": "^12.1.2",
    "html-to-image": "^1.11.11"
  },
  "devDependencies": {
    "@stencil/core": "^4.27.1",
    "@stencil/sass": "^3.2.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "esbuild": "^0.25.5",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "puppeteer": "^24.3.0"
  }
}
